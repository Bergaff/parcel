{
  "name": "poputchka",
  "version": "0.1.0",
  "private": true,
  "description": "Доска попутных посылок: водители междугородних и международных рейсов + Telegram-бот, который собирает объявления из чатов",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "telegram:webhook": "node scripts/set-webhook.mjs",
    "telegram:delete-webhook": "node scripts/delete-webhook.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.129.0"
  }
}
