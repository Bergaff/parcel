# Админский скрипт и стили обновляются часто: кэшируем на 5 минут,
# чтобы после деплоя браузер быстро подхватил новую версию панели.
/app.js
  Cache-Control: public, max-age=300
/styles.css
  Cache-Control: public, max-age=300

# Fallback рекламной сети: правится руками, кэш короткий
/fallback.js
  Cache-Control: public, max-age=300

# Фавиконы не меняются — держим в кэше неделю
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
