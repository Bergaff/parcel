# Админский скрипт и стили обновляются часто: кэшируем на 5 минут,
# чтобы после деплоя браузер быстро подхватил новую версию панели.
/app.js
  Cache-Control: public, max-age=300
/styles.css
  Cache-Control: public, max-age=300

# Fallback рекламной сети: правится руками, кэш короткий
/fallback.js
  Cache-Control: public, max-age=300
  Content-Type: text/javascript; charset=utf-8

# Фавиконы: в HTML ссылки идут с ?v=<версия> (новый релиз = новый адрес),
# а сам файл по прямому пути Яндекс может качать и без версии — держим
# кэш коротким, чтобы поисковик быстро увидел замену
/favicon.ico
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600
